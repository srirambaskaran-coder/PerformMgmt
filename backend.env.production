# Backend Environment Configuration - Production

# Application Environment
NODE_ENV=production
APP_ENV=production

# Server Configuration
PORT=3000

# Session Secret
SESSION_SECRET=your-production-session-secret-change-this

# ===== PRODUCTION DATABASE =====
