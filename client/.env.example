# Frontend Environment Configuration
# Copy this file to .env and update values as needed

# ================================================
# ENVIRONMENT DETECTION
# ================================================
# Set the app environment explicitly (overrides URL-based detection)
# Options: development, qc, production
# VITE_APP_ENV=development

# ================================================
# API BASE URLs
# ================================================
# Override the API base URL for any environment
# VITE_API_BASE_URL=http://localhost:3000

# Environment-specific API URLs (used when VITE_API_BASE_URL is not set)
# Development (default: http://localhost:3000)
# VITE_DEV_API_URL=http://localhost:3000

# QC/Staging API URL
# VITE_QC_API_URL=http://your-qc-api.com

# Production API URL
# VITE_PROD_API_URL=https://your-prod-api.com

# ================================================
# EXAMPLE CONFIGURATIONS
# ================================================

# --- Local Development ---
# VITE_APP_ENV=development
# VITE_API_BASE_URL=http://localhost:3000
# VITE_BASE_PATH=./

# --- QC Environment (smeqc.hfactor.app:8443/PMSUI) ---
# VITE_APP_ENV=qc
# VITE_BASE_PATH=/PMSUI/
# VITE_API_BASE_URL=https://smeqc.hfactor.app:8443/PMS_API

# --- Production Environment ---
# VITE_APP_ENV=production
# VITE_BASE_PATH=/PMSUI/
# VITE_API_BASE_URL=https://sme.hfactor.app/PerformanceMgt
