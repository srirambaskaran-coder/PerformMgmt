    "cors": "^2.8.5",
    "docxtemplater": "^3.66.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "googleapis": "^160.0.0",
    "memoizee": "^0.4.17",
    "memorystore": "^1.6.7",
    "mssql": "^9.0.1",
    "nodemailer": "^7.0.6",
    "openid-client": "^6.8.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.17.2",
