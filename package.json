  "scripts": {
    "dev": "cross-env NODE_ENV=development APP_ENV=development tsx server/index.ts",
    "build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:qc": "cross-env NODE_ENV=production APP_ENV=qc node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production APP_ENV=production node dist/index.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
