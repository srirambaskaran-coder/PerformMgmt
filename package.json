    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pdfkit": "^0.17.3",
    "@types/ws": "^8.5.13",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
